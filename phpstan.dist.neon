includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

parameters:
    level: max

    paths:
        - src
        - tests

    excludePaths:
        # Generated by the Symfony skeleton and owned by the framework, not
        # by this project. getAllowedEnvs() is called from the kernel trait,
        # which analysis cannot trace, and the file should not carry
        # project-specific annotations to work around that.
        - src/Kernel.php

    # Lets the Symfony extension resolve services, so `$container->get()`
    # and friends are type-checked rather than assumed to return object.
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
