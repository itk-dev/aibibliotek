<!DOCTYPE html>
<html lang="da">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block subject %}{{ brand_name }}{% endblock %}</title>
    </head>
    <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: {{ palette_text }}; max-width: 640px; margin: 0 auto; padding: 24px;">
        <main>
            {% block content %}{% endblock %}
        </main>
        <hr style="border: 0; border-top: 1px solid {{ palette_line }}; margin: 32px 0;">
        <footer style="font-size: 12px; color: {{ palette_text_muted }};">
            {{ brand_name }}
        </footer>
    </body>
</html>
