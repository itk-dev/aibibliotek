{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.organization.edit.title'|trans({'%brand%': brand_name, '%name%': organization.name}) }}{% endblock %}

{% block body %}
    <section class="max-w-2xl">
        <twig:Eyebrow as="p" class="mb-4">{{ 'admin.organization.eyebrow'|trans }}</twig:Eyebrow>
        <twig:Heading level="1" size="lg" class="mb-6">{{ 'admin.organization.edit.heading'|trans({'%name%': organization.name}) }}</twig:Heading>

        {{ include('admin/organization/_form.html.twig', {
            form: form,
            submit_label: 'admin.organization.action.update',
        }) }}
    </section>
{% endblock %}
