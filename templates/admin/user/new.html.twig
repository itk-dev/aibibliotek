{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.users.new.title'|trans({'%brand%': brand_name}) }}{% endblock %}

{% block body %}
    <section class="max-w-md">
        <twig:Eyebrow as="p" class="mb-4">{{ 'admin.users.eyebrow'|trans }}</twig:Eyebrow>
        <twig:Heading level="1" size="lg" class="mb-6">{{ 'admin.users.new.heading'|trans }}</twig:Heading>

        {% if domain_error %}
            <twig:Alert type="danger" class="mb-4">
                {{ domain_error }}
            </twig:Alert>
        {% endif %}

        {{ form_start(form, {action: path('app_admin_user_new'), attr: {class: 'grid gap-4'}}) }}
            {{ form_row(form.email) }}
            {{ form_row(form.name) }}
            {{ form_row(form.password) }}
            {{ form_row(form.roles) }}
            {{ form_row(form.status) }}

            <div class="flex items-center gap-4">
                <twig:Form:Button type="submit">
                    {{ 'admin.users.action.create'|trans }}
                </twig:Form:Button>
                <a class="text-sm text-text underline hover:text-primary" href="{{ path('app_admin_users') }}">
                    {{ 'admin.users.action.cancel'|trans }}
                </a>
            </div>
        {{ form_end(form) }}
    </section>
{% endblock %}
