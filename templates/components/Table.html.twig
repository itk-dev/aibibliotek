{% props class = '' %}
{# Outer admin-list table. Wraps the `<table>` in a horizontally #}
{# scrollable container so narrow viewports get a sideways scroll #}
{# rather than a squished layout. Slot in `<twig:Table:Head>` + #}
{# `<twig:Table:Body>` (or arbitrary `<thead>` / `<tbody>` markup). #}
<div class="overflow-x-auto rounded-lg border border-line{{ class ? ' ' ~ class : '' }}">
    <table class="w-full border-collapse text-left text-sm">
        {% block content %}{% endblock %}
    </table>
</div>
