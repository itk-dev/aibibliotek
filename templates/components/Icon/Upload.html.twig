{% props class = 'h-5 w-5' %}
{# Upload arrow glyph (upward arrow into a tray). `class` sizes the icon #}
{# and picks the color via text-* utilities since the stroke inherits #}
{# `currentColor`. Callers add `aria-label`/`title` on the wrapping button #}
{# or link — the glyph is decorative and stays `aria-hidden`. #}
<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.5"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="{{ class }}"
     aria-hidden="true"
     {{ attributes }}>
    <path d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 7.5m0 0L7.5 12M12 7.5V21" />
</svg>
