{% props class = 'h-5 w-5' %}
{# Pencil / edit glyph. `class` sizes the icon and picks the color via #}
{# text-* utilities since the stroke inherits `currentColor`. Callers add #}
{# `aria-label`/`title` on the wrapping button or link — the glyph is #}
{# decorative and stays `aria-hidden`. #}
<svg xmlns="http://www.w3.org/2000/svg"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="1.5"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="{{ class }}"
     aria-hidden="true"
     {{ attributes }}>
