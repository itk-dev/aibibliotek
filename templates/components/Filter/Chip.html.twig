{% props href, label, removeLabel %}
<a href="{{ href }}"
   class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface-2 px-2.5 py-1 text-sm text-ink no-underline hover:border-border-strong hover:bg-surface"
   aria-label="{{ removeLabel }}">
    <span>{{ label }}</span>
    <span aria-hidden="true"
          class="inline-flex h-3.5 w-3.5 items-center justify-center rounded-full bg-line text-[10px] leading-none text-ink">
        ×
    </span>
</a>
