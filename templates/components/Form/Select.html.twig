{% props id, name %}
{# Options are supplied by the call site via the default slot so option #}
{# labels can carry their own `|trans` keys; the component owns only the #}
{# `<select>` shell and its styling. `{{ attributes }}` spreads arbitrary #}
{# call-site attributes (e.g. `data-*` Stimulus hooks) and merges any #}
{# extra `class` onto the default appearance. #}
<select id="{{ id }}" name="{{ name }}"
        {{ attributes.defaults({class: 'w-full rounded-lg border border-line bg-surface px-3 py-2 text-sm text-ink focus:outline-none focus:ring-2 focus:ring-primary/40'}) }}>
    {% block content %}{% endblock %}
</select>
