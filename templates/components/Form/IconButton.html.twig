{% props
    href = null,
    type = 'button',
    shape = 'rounded',
    size = 'sm',
    tone = 'primary',
%}
{# Square outlined button for icon-only affordances (edit, delete, close). #}
{# `size` maps to a fixed square (`sm` = h-8 w-8, `md` = h-9 w-9); `shape` #}
{# picks the border radius; `tone` sets the resting color and the hover #}
{# treatment. `neutral` is used for character glyphs like the modal-close #}
{# ×, so it also bumps the glyph size to `text-lg leading-none` — the SVG- #}
{# icon tones (`primary`, `danger`) don't need that because the child #}
{# `Icon:*` component sizes itself. When `href` is set the component #}
{# renders an anchor instead of a button so the affordance can double as a #}
{# navigation link without nesting `<a>` inside `<button>`. #}
{% set shapes = {
    rounded: 'rounded-lg',
    pill: 'rounded-full',
} %}
{% set sizes = {
    sm: 'h-8 w-8',
    md: 'h-9 w-9',
} %}
{% set tones = {
    primary: 'text-text-muted hover:border-primary hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/40',
    danger: 'text-text-muted hover:border-red-600 hover:text-red-600 focus:outline-none focus:ring-2 focus:ring-red-500/40',
    neutral: 'text-lg leading-none text-text hover:bg-surface-2 focus:outline-none focus:ring-2 focus:ring-primary/40',
} %}
{% set baseClass = 'inline-flex shrink-0 items-center justify-center border border-line transition-colors ' ~ shapes[shape] ~ ' ' ~ sizes[size] ~ ' ' ~ tones[tone] %}
{% set slot %}{% block content %}{% endblock %}{% endset %}
{% if href is not null %}
<a href="{{ href }}" class="no-underline {{ baseClass }}" {{ attributes }}>{{ slot }}</a>
{% else %}
<button type="{{ type }}" class="{{ baseClass }}" {{ attributes }}>{{ slot }}</button>
{% endif %}
