<!DOCTYPE html>
<html lang="da">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ brand_name }}{% endblock %}</title>
        {# On-brand favicon: green-700 rounded tile with a white wordmark. #}
        {# Brand fonts are self-hosted via @font-face in app.css, so no #}
        {# remote font <link> or preconnect is required. #}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%23478523%22/><text x=%2264%22 y=%2288%22 font-family=%22Arial,sans-serif%22 font-size=%2264%22 font-weight=%22700%22 fill=%22white%22 text-anchor=%22middle%22>ai</text></svg>">

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex min-h-screen flex-col {% block body_bg %}bg-bg{% endblock %} text-text antialiased">
        <twig:Layout:SkipLink />

        <twig:Layout:SiteHeader>
            <twig:Nav:Menu>
                <twig:Nav:Link href="{{ path('app_assistant_catalog') }}"
                               :active="app.current_route == 'app_assistant_catalog'">
                    {{ 'nav.links.catalog'|trans }}
                </twig:Nav:Link>
                <twig:Nav:Link href="{{ path('app_assistant_new') }}"
                               :active="app.current_route == 'app_assistant_new'">
                    {{ 'nav.links.share'|trans }}
                </twig:Nav:Link>
                {% if app.user %}
                    <twig:Nav:Link href="{{ path('app_user_assistants') }}"
                                   :active="app.current_route == 'app_user_assistants'">
                        {{ 'nav.links.mine'|trans }}
                    </twig:Nav:Link>
                    <twig:Layout:UserMenu />
                {% endif %}
            </twig:Nav:Menu>
        </twig:Layout:SiteHeader>

        {#
            `<main>` shares the wide container (`max-w-wide`,
            ≈ 1600px) with the site header and footer so the three
            chrome edges line up. The single-column layout applies a
            narrower `max-w-narrow` (≈ 1180px) inner wrapper on
            content that needs it — see `<twig:Layout:SingleColumn>`.
            Skip-link target / focus ring stay on `#main`.
        #}
        <main id="main"
              class="mx-auto w-full max-w-wide flex-1 px-[clamp(20px,4vw,56px)] py-[clamp(24px,4vw,56px)]"
              tabindex="-1">
            {% block body %}{% endblock %}
        </main>

        <twig:Layout:SiteFooter linkHref="#" linkLabel="layout.footer.about_link">
            {{ 'layout.footer.caption_html'|trans({'%link%': '#'})|raw }}
        </twig:Layout:SiteFooter>
    </body>
</html>
