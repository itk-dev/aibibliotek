{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ai-reolen.local.itkdev.dk/schema/openwebui-model.json",
    "title": "OpenWebUI model export",
    "description": "Accepts the three shapes an OpenWebUI model export can arrive in: a top-level array holding exactly one model, a single flat model object, or a single object wrapping the model under `info`.",
    "anyOf": [
        {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "$ref": "#/$defs/model" }
        },
        { "$ref": "#/$defs/model" },
        {
            "type": "object",
            "required": ["info"],
            "properties": {
                "info": { "$ref": "#/$defs/model" }
            }
        }
    ],
    "$defs": {
        "model": {
            "type": "object",
            "required": ["name"],
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "base_model_id": { "type": ["string", "null"] },
                "model": { "type": "string" },
                "params": {
                    "type": "object",
                    "properties": {
                        "system": { "type": "string" }
                    }
                },
                "meta": {
                    "type": "object",
                    "properties": {
                        "description": { "type": "string" },
                        "profile_image_url": { "type": ["string", "null"] },
                        "capabilities": { "type": "object" },
                        "suggestion_prompts": {
                            "type": ["array", "null"],
                            "items": {
                                "type": "object",
                                "properties": {
                                    "content": { "type": "string" }
                                }
                            }
                        },
                        "tags": {
                            "type": "array",
                            "items": {
                                "anyOf": [
                                    { "type": "string" },
                                    {
                                        "type": "object",
                                        "required": ["name"],
                                        "properties": {
                                            "name": { "type": "string" }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                }
            }
        }
    }
}
