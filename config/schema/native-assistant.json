{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ai-reolen.local.itkdev.dk/schema/native-assistant.json",
    "title": "AI-reolen native assistant",
    "description": "The catalogue's own lossless interchange format: an envelope (`format`, `version`) wrapping the neutral canonical fields. The `format` const discriminates it from every third-party format.",
    "type": "object",
    "required": ["format", "name"],
    "properties": {
        "format": { "const": "ai-reolen" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "systemPrompt": { "type": ["string", "null"] },
        "baseModel": { "type": ["string", "null"] },
        "tags": {
            "type": "array",
            "items": { "type": "string" }
        },
        "conversationStarters": {
            "type": "array",
            "items": { "type": "string" }
        }
    }
}
